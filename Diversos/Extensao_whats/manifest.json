{
  "manifest_version": 3,
  "name": "TGameAjuda Edita Whats",
  "version": "1.0.1",
  "description": "Camada leve de produtividade para o WhatsApp Web: respostas rápidas com atalhos. Não envia mensagens automaticamente; tudo fica salvo só no seu navegador.",
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content/loader.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*", "icons/*"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "action": {
    "default_title": "TGameAjuda Edita Whats (Alt+R)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+R" },
      "description": "Abrir/fechar o painel de respostas rapidas"
    }
  }
}
