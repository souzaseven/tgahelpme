  <td style="text-align: center; ; width: 99%"><p class="line862"> <strong>FALEWEB</strong> </td>
  <td colspan="1" rowspan="2" style="text-align: center;  vertical-align: bottom;"><p class="line862"> <img alt="http://www.dti.digitro.com.br/mywiki/ATUMX?action=AttachFile&amp;do=get&amp;target=digitro_new.JPG" class="external_image" src="http://www.dti.digitro.com.br/mywiki/ATUMX?action=AttachFile&amp;do=get&amp;target=digitro_new.JPG" title="http://www.dti.digitro.com.br/mywiki/ATUMX?action=AttachFile&amp;do=get&amp;target=digitro_new.JPG" /> </td>
